DATABASE_URL=postgresql+asyncpg://voicelab:voicelab@localhost:5433/voicelab
ADK_DATABASE_URL=postgresql+asyncpg://voicelab:voicelab@localhost:5433/voicelab

# One key per provider — covers both STT and TTS for that provider.
# Agents pick which provider to use in their config; only set the keys you plan to use.
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

# Optional: STT evaluation (records mic audio and re-transcribes with each provider).
# Off by default; tunables shown with their code defaults.
ENABLE_STT_EVALUATION=false
STT_EVALUATION_RECORDINGS_DIR=recordings
STT_EVALUATION_DEEPGRAM_MODEL=nova-3-monolingual
STT_EVALUATION_ELEVENLABS_MODEL=scribe_v2
STT_EVALUATION_SARVAM_MODEL=saarika:v2.5
STT_EVALUATION_SARVAM_URL=https://api.sarvam.ai/speech-to-text

CORS_ORIGINS=http://localhost:5173
